{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.invalid/schemas/review-run.schema.json",
  "title": "Agent Harness review-run record",
  "type": "object",
  "required": ["format", "format_version", "record_type", "protocol", "record_id", "run_id", "created_from", "record_digest", "canonical_digest"],
  "properties": {
    "format": { "const": "review-run" },
    "format_version": { "const": 1 },
    "record_type": {
      "type": "string",
      "enum": [
        "request",
        "routing-decision",
        "discovery",
        "shard-plan",
        "review-ledger",
        "control-revision",
        "aggregate-report",
        "gate-result"
      ]
    },
    "protocol": { "const": "review-run" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonical_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "record_id": { "type": "string", "minLength": 1 },
    "created_from": { "type": "array", "items": { "type": "string" } },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "active_change": { "type": "string", "minLength": 1 },
    "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "discovery_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "aggregate_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "dispatch_contract": {
      "type": "object",
      "required": ["rules", "scope", "dimensions", "relations", "contract_digest"],
      "properties": {
        "contract_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "rules": { "type": "array", "minItems": 1 },
        "scope": { "type": "array", "minItems": 1 },
        "dimensions": { "type": "array", "minItems": 1 },
        "relations": { "type": "array", "minItems": 1 }
      },
      "additionalProperties": true
    },
    "entries": { "type": "array" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "attempt_status": { "enum": ["succeeded", "failed", "cancelled", "stale", "superseded"] },
    "shard_id": { "type": "string", "minLength": 1 },
    "relations": { "type": "array", "minItems": 1 },
    "shards": { "type": "array", "minItems": 1 },
    "coverage_gate": { "enum": ["READY", "READY_WITH_NOTES", "NOT_READY", "NEEDS_USER_DECISION"] },
    "review_gate": { "enum": ["READY", "READY_WITH_NOTES", "NOT_READY", "NEEDS_USER_DECISION"] },
    "implementation_verification_gate": { "enum": ["READY", "READY_WITH_NOTES", "NOT_READY", "NEEDS_USER_DECISION"] },
    "overall_gate": { "enum": ["READY", "READY_WITH_NOTES", "NOT_READY", "NEEDS_USER_DECISION"] }
  },
  "additionalProperties": true,
  "x-portable-record-rules": {
    "forbiddenKeys": ["absolute_path", "absolute_root", "cwd", "local_root", "run_root", "session_id"],
    "pathRule": "relative-only",
    "digestRule": "sha256(canonical-json(record-without-record_digest))"
  }
}
