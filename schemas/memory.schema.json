{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/catwithoutear/agent-harness-core/schemas/memory.schema.json",
  "title": "Agent Harness Memory Contract",
  "type": "object",
  "required": ["artifact", "status", "tags"],
  "properties": {
    "artifact": {
      "type": "string",
      "enum": [
        "memory-index",
        "memory-language",
        "memory-subsystem",
        "memory-map",
        "memory-pattern",
        "memory-decision"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["verified", "superseded"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "description": { "type": "string" },
    "last_verified": { "type": "string" },
    "source_revision": { "type": "string" }
  }
}
