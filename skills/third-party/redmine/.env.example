# Redmine Configuration
# Copy this file to .env and fill in your credentials

# Redmine server URL (required)
# Example: https://redmine.scutech.com/redmine
REDMINE_BASE_URL=your-redmine-url-here

# Redmine API key (required)
# Get your API key from: Redmine → My Account → API Access Key
REDMINE_API_KEY=your-api-key-here

# SSL certificate verification (optional)
# Set to "true" to disable SSL verification (not recommended for production)
# REDMINE_NO_SSL_VERIFY=false

# Request timeout in seconds (optional)
# REDMINE_TIMEOUT=30
